{
  "name": "tiptap-inline-comments",
  "version": "1.0.0",
  "description": "Tiptap extensions for inline comments and inline comment replies.",
  "packageManager": "yarn@4.12.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "release": "semantic-release"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "nanoid": "^5.1.11"
  },
  "peerDependencies": {
    "@tiptap/core": ">=3.0.0",
    "@tiptap/pm": ">=3.0.0"
  },
  "devDependencies": {
    "@tiptap/core": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "semantic-release": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "tiptap",
    "tiptap-extension",
    "prosemirror",
    "comments",
    "inline-comments"
  ],
  "author": {
    "name": "Thomas Schoffelen"
  }
}
