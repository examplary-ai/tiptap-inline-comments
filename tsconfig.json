{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "skipLibCheck": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "target": "ES2020"
  },
  "files": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
